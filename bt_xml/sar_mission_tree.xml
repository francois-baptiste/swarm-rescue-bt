<?xml version="1.0"?>
<!--
  Groot2-viewable rendering of the tree built in swarm/robot.py's
  Robot._build_tree(). This XML isn't executed by the Python simulation
  (bt/core.py is a small standalone engine, not BehaviorTree.CPP) - it
  exists purely so the same mission tree can be opened and inspected
  visually in Groot2, using the exact node names and ports harmonized
  with the nav2-port branch's own ros2_ws/src/swarm_sar_bt/bt_xml/
  sar_mission_tree.xml (which IS a real, executable BT.CPP tree).

  Root is ReactiveFallback because swarm/robot.py re-evaluates the whole
  tree from the top on every simulation tick (there is no persisted
  per-node RUNNING state), which is the same reactive semantics nav2-port
  uses ReactiveFallback for.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="MissionRoot">

      <Sequence name="RescueIfArrived">
        <HasClaim/>
        <IsAtVictim tolerance="0.0"/>
        <RescueVictim/>
      </Sequence>

      <Sequence name="PursueClaim">
        <HasClaim/>
        <NavigateToPose goal="{claim_pose}"/>
      </Sequence>

      <Sequence name="DetectAndClaim">
        <DetectVictim sensor_range="2.5" claim_timeout="15"
                      seen_victim_id="{seen_victim_id}"/>
        <ClaimVictim seen_victim_id="{seen_victim_id}"/>
      </Sequence>

      <Sequence name="Explore">
        <PickExploreGoal/>
        <NavigateToPose goal="{explore_goal}"/>
      </Sequence>

    </ReactiveFallback>
  </BehaviorTree>

  <!-- Node models so Groot2 draws the right shape/ports for each custom
       leaf even though no C++ plugin registers them for this branch. -->
  <TreeNodesModel>
    <Condition ID="HasClaim"/>
    <Condition ID="IsAtVictim">
      <input_port name="tolerance" default="0.0">grid cell match, unlike nav2-port's metric tolerance</input_port>
    </Condition>
    <Action ID="RescueVictim"/>
    <Action ID="NavigateToPose">
      <input_port name="goal">BFS-walked grid cell, unlike nav2-port's real Nav2 goal pose</input_port>
    </Action>
    <Condition ID="DetectVictim">
      <input_port name="sensor_range" default="2.5"/>
      <input_port name="claim_timeout" default="15">ticks, not seconds</input_port>
      <output_port name="seen_victim_id"/>
    </Condition>
    <Action ID="ClaimVictim">
      <input_port name="seen_victim_id"/>
    </Action>
    <Action ID="PickExploreGoal">
      nearest unvisited BFS frontier cell, unlike nav2-port's random radius sample
    </Action>
  </TreeNodesModel>
</root>
